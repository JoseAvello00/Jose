import random
import time

class Guerreiro:
    """
    Representa um guerreiro no jogo, com atributos de combate e ações.
    """
    def __init__(self, nome: str, saude: float = 100.0, forca_ataque: float = 15.0, pocoes_cura: int = 2):
        self.__nome = nome
        self.__saude_maxima = saude
        self.__saude = saude
        self.__forca_ataque = forca_ataque
        self.__pocoes_cura = pocoes_cura
        self.__relatorio_batalha = [f"{self.__nome} entrou na arena!"] # Similar ao extrato

    @property
    def nome(self):
        """Retorna o nome do guerreiro."""
        return self.__nome

    @property
    def saude(self):
        """Retorna a saúde atual do guerreiro."""
        return self.__saude

    @property
    def esta_vivo(self):
        """Verifica se o guerreiro ainda está vivo."""
        return self.__saude > 0

    def atacar(self, alvo: 'Guerreiro'):
        """
        Ataca outro guerreiro, causando dano.
        O dano tem uma pequena variação para tornar a batalha mais dinâmica.
        """
        if not self.esta_vivo:
            print(f"{self.nome} não pode atacar, pois está derrotado.")
            return

        # Dano varia entre 80% e 120% da força de ataque
        variacao = random.uniform(0.8, 1.2)
        dano = self.__forca_ataque * variacao
        
        print(f"\n💥 {self.nome} ataca {alvo.nome} com fúria!")
        alvo.receber_dano(dano, self.nome)
        
        # Adiciona evento ao relatório
        self.__relatorio_batalha.append(f"Atacou {alvo.nome}, causando {dano:.2f} de dano.")

    def receber_dano(self, dano: float, atacante_nome: str):
        """
        Reduz a saúde do guerreiro ao receber um ataque.
        """
        self.__saude -= dano
        if self.__saude < 0:
            self.__saude = 0
        
        print(f"🛡️ {self.nome} sofreu {dano:.2f} de dano de {atacante_nome}!")
        print(f"❤️  Saúde de {self.nome}: {self.saude:.2f}")

        # Adiciona evento ao relatório do alvo
        self.__relatorio_batalha.append(f"Recebeu {dano:.2f} de dano de {atacante_nome}.")

    def usar_pocao(self):
        """
        Usa uma poção para restaurar uma parte da saúde.
        """
        if not self.esta_vivo:
            print(f"{self.nome} não pode se curar, pois está derrotado.")
            return

        if self.__pocoes_cura > 0:
            # Poção cura 30% da saúde máxima
            cura = self.__saude_maxima * 0.30
            self.__saude += cura
            
            # Garante que a saúde não ultrapasse o máximo
            if self.__saude > self.__saude_maxima:
                self.__saude = self.__saude_maxima

            self.__pocoes_cura -= 1
            print(f"\n🧪 {self.nome} bebeu uma poção e recuperou {cura:.2f} de vida!")
            print(f"❤️  Saúde de {self.nome}: {self.saude:.2f}")
            print(f"Poções restantes: {self.__pocoes_cura}")
            
            self.__relatorio_batalha.append(f"Usou uma poção e curou {cura:.2f} de vida.")
        else:
            print(f"\n❌ {self.nome} não tem mais poções de cura!")

    def mostrar_status(self):
        """
        Exibe o status atual do guerreiro, incluindo saúde e poções.
        """
        print("\n--- STATUS DO GUERREIRO ---")
        print(f"Nome: {self.nome}")
        print(f"Saúde: {self.saude:.2f} / {self.__saude_maxima:.2f}")
        print(f"Força de Ataque: {self.__forca_ataque:.2f}")
        print(f"Poções de Cura: {self.__pocoes_cura}")
        print("---------------------------\n")
        
    def ver_relatorio_batalha(self):
        """Exibe o histórico de ações na batalha."""
        print(f"\n--- RELATÓRIO DE BATALHA DE {self.nome} ---")
        if not self.__relatorio_batalha:
            print("Nenhuma ação registrada.")
        else:
            for item in self.__relatorio_batalha:
                print(f"- {item}")
        print("----------------------------------------")

# --- Interface Interativa do Jogo de Guerra ---
print("--- Bem-vindo à Arena de Batalha ---")

# Criação dos dois guerreiros
nome_g1 = input("Digite o nome do Guerreiro 1: ")
guerreiro1 = Guerreiro(nome_g1, forca_ataque=18, pocoes_cura=2)
print(f"Guerreiro {guerreiro1.nome} foi criado!\n")

nome_g2 = input("Digite o nome do Guerreiro 2: ")
guerreiro2 = Guerreiro(nome_g2, forca_ataque=12, saude=120, pocoes_cura=3)
print(f"Guerreiro {guerreiro2.nome} foi criado!\n")

guerreiro_ativo = guerreiro1
oponente = guerreiro2
batalha_em_andamento = True

while batalha_em_andamento:
    print(f"\n--- TURNO DE: {guerreiro_ativo.nome} ---")
    guerreiro_ativo.mostrar_status()
    
    print("1. Atacar")
    print("2. Usar Poção de Cura")
    print("3. Ver Relatório de Batalha")
    print("0. Desistir")
    escolha = input("Escolha sua ação: ")

    if escolha == '1':
        guerreiro_ativo.atacar(oponente)
    
    elif escolha == '2':
        guerreiro_ativo.usar_pocao()

    elif escolha == '3':
        guerreiro_ativo.ver_relatorio_batalha()
        continue # Pula a troca de turno para que o jogador possa agir

    elif escolha == '0':
        print(f"{guerreiro_ativo.nome} desistiu da batalha. {oponente.nome} é o vencedor!")
        batalha_em_andamento = False
        continue

    else:
        print("Opção inválida. Tente novamente.")
        continue # Pula a troca de turno
        
    # Animação de espera
    time.sleep(1.5)

    # Verifica condição de vitória
    if not oponente.esta_vivo:
        print(f"\n🏆 A saúde de {oponente.nome} chegou a zero!")
        print(f"O grande vencedor da batalha é {guerreiro_ativo.nome}!")
        batalha_em_andamento = False
    else:
        # Troca o turno
        if guerreiro_ativo == guerreiro1:
            guerreiro_ativo = guerreiro2
            oponente = guerreiro1
        else:
            guerreiro_ativo = guerreiro1
            oponente = guerreiro2

print("\n--- FIM DE JOGO ---")
